# ==========================================
# TRAIT Advocate Pro AI — Environment Configuration
# ==========================================

# Application
PROJECT_NAME="TRAIT Advocate Pro AI"
SECRET_KEY="replace-with-a-secure-random-secret-key"

# Database Configuration (PostgreSQL / Neon or local SQLite)
# For Neon / PostgreSQL:
# DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# For Local Development (Default):
DATABASE_URL="sqlite:///./advocate_pro.db"

# AI Provider Credentials (Optional — fallback jurisprudence engine runs automatically when keys are omitted)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Frontend API URL (Configured in frontend/.env for production)
# VITE_API_URL="https://your-backend-domain.com/api/v1"
